# =============================================================================
# MakIA Restaurante - Variables de Entorno (Producción)
# contacpro.app
# =============================================================================
#
# Copia este archivo a .env y configura los valores:
# cp .env.example .env
#

# =============================================================================
# GENERAL
# =============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# =============================================================================
# BASE DE DATOS
# =============================================================================
# PostgreSQL connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_PASSWORD=tu_contraseña_segura_aqui
DATABASE_URL=postgresql://makia:${DB_PASSWORD}@localhost:5432/makia_production

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTENTICACIÓN
# =============================================================================
# JWT Secret - Generar con: openssl rand -base64 64
JWT_SECRET=tu_jwt_secret_super_seguro_de_64_caracteres_minimo
JWT_EXPIRES_IN=7d

# =============================================================================
# URLS
# =============================================================================
APP_URL=https://contacpro.app
API_URL=https://api.contacpro.app
DASHBOARD_URL=https://dashboard.contacpro.app

# =============================================================================
# WEBHOOKS
# =============================================================================
# Secret para firmar webhooks - Generar con: openssl rand -base64 32
WEBHOOK_SECRET=tu_webhook_secret_aqui

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=MakIA Restaurante <noreply@contacpro.app>

# Alternativa: SendGrid
# SENDGRID_API_KEY=SG.xxxx

# Alternativa: Mailgun
# MAILGUN_API_KEY=xxxx
# MAILGUN_DOMAIN=mg.contacpro.app

# =============================================================================
# SMS (Twilio)
# =============================================================================
# Obtener en https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+34600000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# =============================================================================
# WHATSAPP BUSINESS
# =============================================================================
# Configurar en https://developers.facebook.com
WHATSAPP_API_TOKEN=EAAxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789

# =============================================================================
# TELEGRAM
# =============================================================================
# Crear bot con @BotFather y obtener token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# =============================================================================
# PAGOS (Stripe)
# =============================================================================
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# IDs de precios de Stripe
STRIPE_PRICE_STARTER=price_xxxxx
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_BUSINESS=price_xxxxx

# =============================================================================
# ALMACENAMIENTO (Opcional - para imágenes)
# =============================================================================
# AWS S3
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxx
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=makia-uploads

# Cloudflare R2 (compatible S3)
# R2_ACCESS_KEY_ID=xxxxx
# R2_SECRET_ACCESS_KEY=xxxxx
# R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# R2_BUCKET=makia-uploads

# =============================================================================
# ANALYTICS (Opcional)
# =============================================================================
# Google Analytics
# GA_TRACKING_ID=G-XXXXXXXX

# Plausible
# PLAUSIBLE_DOMAIN=contacpro.app

# =============================================================================
# MONITOREO (Opcional)
# =============================================================================
# Sentry
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# DESARROLLO/DEBUG
# =============================================================================
# Solo para desarrollo
# DEBUG=true
# PRISMA_QUERY_LOG=true

# pgAdmin (solo con Docker)
PGADMIN_EMAIL=admin@contacpro.app
PGADMIN_PASSWORD=admin_password_seguro
