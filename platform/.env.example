# ============================================
# MakIA Platform - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://makia:makia_secret@localhost:5432/makia_reservas"

# Redis (cache y colas)
REDIS_URL="redis://localhost:6379"

# JWT Secret (cambiar en producción!)
# Generar con: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Entorno
NODE_ENV="development"
PORT=3000

# API URL (para el widget y SDK)
API_URL="http://localhost:3000/v1"

# ============================================
# OPCIONAL: Servicios externos
# ============================================

# Twilio (SMS)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# SendGrid (Email)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL=""

# Stripe (Pagos/Suscripciones)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# WhatsApp Business API
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
